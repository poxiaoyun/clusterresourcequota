{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "admissionWebhooks": {
      "type": "object",
      "title": "准入控制",
      "required": [
        "acceleratorVendor"
      ],
      "properties": {
        "acceleratorVendor": {
          "type": "string",
          "title": "集群加速卡类型",
          "description": "NVIDIA 集群会为未申请 GPU 的容器注入 NVIDIA_VISIBLE_DEVICES=void；华为集群不执行该注入。",
          "default": "nvidia",
          "enum": [
            "nvidia",
            "huawei"
          ],
          "x-enum": [
            {
              "value": "nvidia",
              "label": "NVIDIA",
              "description": "启用未申请 GPU 容器的 NVIDIA 设备隔离"
            },
            {
              "value": "huawei",
              "label": "华为",
              "description": "不注入 NVIDIA_VISIBLE_DEVICES"
            }
          ]
        }
      }
    }
  }
}
